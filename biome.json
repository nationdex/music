{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "site/assets/js/**",
      "site/assets/app.css",
      "site/assets/uno.config.js",
      "site/manifest.webmanifest",
      ".claude/settings.json",
      "biome.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 140, "lineEnding": "lf" },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "none", "arrowParentheses": "always" } },
  "css": { "formatter": { "enabled": true, "quoteStyle": "double" } },
  "json": { "formatter": { "enabled": true } },
  "linter": { "enabled": false },
  "assist": { "enabled": false }
}
