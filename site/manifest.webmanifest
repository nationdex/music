{
  "id": "/",
  "name": "Adi Music",
  "short_name": "Adi Music",
  "description": "Play your local music in the browser with playlists, equalizer, playback speed, and offline listening.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/library/tracks",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#271816",
  "theme_color": "#271816",
  "categories": ["music", "entertainment"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "icons": [
    { "src": "/images/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/images/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/images/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/images/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Tracks", "url": "/library/tracks", "icons": [{ "src": "/images/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Albums", "url": "/library/albums", "icons": [{ "src": "/images/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    {
      "name": "Playlists",
      "url": "/library/playlists",
      "icons": [{ "src": "/images/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    { "name": "Discovery", "url": "/discovery", "icons": [{ "src": "/images/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "screenshots": [
    {
      "src": "/images/screenshots/wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Your library on desktop"
    },
    {
      "src": "/images/screenshots/narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Your library on a phone"
    }
  ],
  "file_handlers": [
    {
      "action": "/library/tracks",
      "name": "Audio files",
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/mp4": [".m4a", ".m4b"],
        "audio/aac": [".aac"],
        "audio/flac": [".flac"],
        "audio/ogg": [".ogg", ".oga", ".opus"],
        "audio/wav": [".wav"]
      }
    }
  ]
}
